---
#### ChangeMe vars ##

## AAP
aap_username: admin
aap_password: "{{ vault_aap_password }}"
aap_hostname: "https://<your-aap-hostname>"
aap_validate_certs: false

## Organization
v_organization_name: Default

## Ansible Vault
v_vault_password: "{{ vault_vault_password }}"

## Github / SCM
v_git_repo_url: git@github.com:<your-org>/workshop-compliance.git
v_git_private_key: "{{ vault_git_private_key }}"

## Automation Hub
v_automationhub_url: https://console.redhat.com/api/automation-hub/content/published/
v_automationhub_auth_url: https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token
v_automationhub_token: "{{ vault_automationhub_token }}"

## RHEL Credentials
v_rhel_username: ec2-user
v_rhel_ssh_private_key: "{{ vault_rhel_ssh_private_key }}"

## Windows Credentials
v_windows_username: Administrator
v_windows_password: "{{ vault_windows_password }}"

## Report Server (receives OpenSCAP scan reports)
v_report_server: "<your-report-server-hostname>"
v_report_server_port: "22"
v_report_server_user: "<your-report-server-username>"
v_report_server_pass: "{{ vault_report_server_pass }}"
